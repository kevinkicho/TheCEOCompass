{
  "name": "ceocompass-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Cloud Functions for CEO Compass (cloud AI provider)",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --import tsx --test src/llm.test.ts src/response-path.test.ts",
    "serve": "npm run build && firebase emulators:start --only functions,database",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
