# Copy values into Firebase secrets / params — do NOT commit real keys.
# See docs/AI_CLOUD_SETUP.md

# Required: bearer token for OpenAI-compatible API (also accepts OLLAMA_API_KEY)
OPENAI_API_KEY=your-ollama-or-openai-key-here
# OLLAMA_API_KEY=  # alias for OPENAI_API_KEY

# Optional: API base
#   https://ollama.com/v1          (Ollama Cloud — default in functions deploy params)
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
OPENAI_API_BASE=https://ollama.com/v1

# Optional: default model when request.payload.model is omitted
CLOUD_AI_MODEL=gemma4:31b-cloud
