# Copy values into Firebase secrets / params — do NOT commit real keys.
# See docs/AI_CLOUD_SETUP.md

# Required: bearer token for OpenAI-compatible API
OPENAI_API_KEY=sk-your-key-here

# Optional: API base (default https://api.openai.com/v1)
# Examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_BASE=https://api.openai.com/v1

# Optional: default model when request.payload.model is omitted
CLOUD_AI_MODEL=gpt-4o-mini
