# Database
DATABASE_URL=sqlite+aiosqlite:///./ceo_platform.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ceo_platform

# LLM Provider — choose one:
#
# Option 1: Ollama local model (free, no API key, pull once)
#   ollama pull gemma3
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=gemma3
#
# Option 2: Ollama Cloud model (API key, weekly free limits, upgrade at https://ollama.com/upgrade)
#   LLM_PROVIDER=ollama
#   OLLAMA_MODEL=gemma4:31b-cloud
#   OLLAMA_API_KEY=your-key-here
#   Get key: https://ollama.com/settings

# Option 3: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Option 4: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-...
# LLM_MODEL=claude-sonnet-4-20250514

# Security
SECRET_KEY=change-this-to-a-random-string

# Environment
ENVIRONMENT=development
