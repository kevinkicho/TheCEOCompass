{
  "rules": {
    "requests": {
      ".indexOn": "status",
      "$requestId": {
        ".read": "auth != null || true",
        ".write": "auth != null || true"
      }
    },
    "frameworks": {
      ".read": true,
      "$slug": {
        ".read": true,
        "$conceptId": {
          ".read": true,
          ".write": "auth != null || true"
        }
      }
    },
    "framework": {
      ".read": true,
      "$slug": {
        "$concept": {
          "$category": {
            "$entryId": {
              ".read": true,
              ".write": "auth != null || true"
            }
          }
        }
      }
    },
    "quotes": {
      "generated": {
        "$quoteId": {
          ".read": true,
          ".write": "auth != null || true"
        }
      }
    },
    "scenario-evaluations": {
      "$evalId": {
        ".read": true,
        ".write": "auth != null || true"
      }
    },
    "comparisons": {
      ".read": true,
      "$frameworkSlug": {
        "$conceptA": {
          "$conceptB": {
            "$mode": {
              "$entryId": {
                ".read": true,
                ".write": "auth != null || true"
              }
            }
          }
        }
      }
    },
    "conceptChats": {
      "$chatId": {
        ".read": true,
        ".write": "auth != null || true"
      }
    },
    "reviews": {
      "$deviceId": {
        "$conceptId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "journal": {
      "$deviceId": {
        "entries": {
          "$entryId": {
            ".read": true,
            ".write": true
          }
        }
      }
    },
    "progress": {
      "$deviceId": {
        ".read": true,
        ".write": true
      }
    },
    "viewed": {
      "$deviceId": {
        ".read": true,
        ".write": true
      }
    },
    "favoriteQuotes": {
      "$deviceId": {
        "$quoteId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "quizResults": {
      "$deviceId": {
        "$resultId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "scenarioHistory": {
      "$deviceId": {
        "$scenarioSlug": {
          "$attemptId": {
            ".read": true,
            ".write": true
          }
        }
      }
    },
    "_meta": {
      ".read": true,
      ".write": "auth != null || true"
    }
  }
}
