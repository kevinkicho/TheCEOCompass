{
  "rules": {
    ".read": false,
    ".write": false,

    "frameworks": {
      ".read": true,
      "$slug": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "concepts": {
          "$conceptId": {
            ".read": true,
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
          }
        }
      }
    },

    "framework": {
      ".read": true,
      "$slug": {
        "$concept": {
          "$category": {
            "$entryId": {
              ".read": true,
              ".write": false
            }
          }
        }
      }
    },

    "comparisons": {
      ".read": true,
      "$frameworkSlug": {
        "$a": {
          "$b": {
            "$mode": {
              "$entryId": {
                ".read": true,
                ".write": false
              }
            }
          }
        }
      }
    },

    "quotes": {
      "generated": {
        "$quoteId": {
          ".read": true,
          ".write": false
        }
      }
    },

    "requests": {
      ".indexOn": ["status", "uid", "created_at"],
      "$requestId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.hasChildren(['uid','status','payload','created_at'])",
        ".validate": "newData.child('created_at').isNumber()"
      }
    },

    "conceptChats": {
      "$chatId": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || !data.child('uid').exists() || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && !data.exists()",
        ".validate": "!newData.child('uid').exists() || newData.child('uid').val() === auth.uid"
      }
    },

    "scenario-evaluations": {
      "$evalId": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || !data.child('uid').exists() || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && !data.exists()",
        ".validate": "!newData.child('uid').exists() || newData.child('uid').val() === auth.uid"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "journal": {
          "entries": {
            "$entryId": {
              ".validate": "newData.hasChildren(['title','created_at']) && newData.child('title').isString() && newData.child('title').val().length <= 500"
            }
          }
        },
        "reviews": {
          "$conceptId": {
            ".validate": "newData.hasChildren(['conceptId','nextReviewAt'])"
          }
        }
      }
    },

    "journal": {
      ".read": false,
      ".write": false
    },
    "reviews": {
      ".read": false,
      ".write": false
    },
    "progress": {
      ".read": false,
      ".write": false
    },
    "viewed": {
      ".read": false,
      ".write": false
    },
    "favoriteQuotes": {
      ".read": false,
      ".write": false
    },
    "quizResults": {
      ".read": false,
      ".write": false
    },
    "scenarioHistory": {
      ".read": false,
      ".write": false
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "mastery": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "edges": {
        "$fromConceptId": {
          "$toConceptId": {
            ".validate": "!newData.exists() || ($fromConceptId !== $toConceptId && newData.hasChildren(['type', 'weight']) && newData.child('type').isString() && (newData.child('type').val() === 'requires' || newData.child('type').val() === 'reinforces' || newData.child('type').val() === 'applied_in') && newData.child('weight').isNumber() && newData.child('weight').val() >= 0 && newData.child('weight').val() <= 1)"
          }
        }
      },
      "concepts": {
        "$conceptId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['frameworkSlug', 'conceptSlug']) && newData.child('frameworkSlug').isString() && newData.child('conceptSlug').isString())"
        }
      }
    },

    "_meta": {
      "framework_slugs": {
        ".read": true,
        ".write": false
      },
      "agent_heartbeat": {
        ".read": true,
        ".write": false
      },
      "mastery_graph": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "_config": {
      ".read": false,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "feature_flags": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    }
  }
}
